#!/bin/bash

# 检查参数数量
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "错误: 需要一个或两个参数"
    echo "用法: $0 <包名> [版本号]"
    echo "示例: $0 taro_cpp_library_v8 1.6.0-alpha.13"
    echo "或者: $0 taro_cpp_library_v8 (自动获取最新版本)"
    exit 1
fi

# 获取参数
PACKAGE_NAME=$1
VERSION=$2

# 如果没有提供版本号，则获取最新版本
if [ -z "$VERSION" ]; then
    echo "未指定版本号，正在获取最新版本..."
    echo "-----------------------------------"
    
    # 使用ohpm info命令获取包信息，提取最新版本号
    VERSION=$(ohpm info ${PACKAGE_NAME} --registry http://ohpm.jd.com/repos/ohpm/ 2>&1 | grep -i latest | sed 's/\x1b\[[0-9;]*m//g' | awk -F': ' '{print $2}' | tr -d ' ')
    
    # 检查是否成功获取版本号
    if [ -z "$VERSION" ]; then
        echo "错误: 无法获取包 ${PACKAGE_NAME} 的最新版本号"
        echo "请检查包名是否正确或手动指定版本号"
        exit 1
    fi
    
    echo "获取到最新版本号: ${VERSION}"
    
    # 如果版本号以-hwasan结尾，去掉这个后缀
    if [[ "$VERSION" == *-hwasan ]]; then
        VERSION="${VERSION%-hwasan}"
        echo "检测到-hwasan后缀，已自动去除，使用版本号: ${VERSION}"
    fi
    echo "-----------------------------------"
fi

# 拼接下载链接
URL="http://ohpm.jd.com/ohpm/${PACKAGE_NAME}/-/${PACKAGE_NAME}-${VERSION}.har"

# 输出下载信息
echo "正在下载包: ${PACKAGE_NAME}"
echo "版本: ${VERSION}"
echo "下载地址: ${URL}"
echo "-----------------------------------"

# 使用curl下载文件到当前目录
curl -O "${URL}"

# 检查下载结果
if [ $? -eq 0 ]; then
    echo "-----------------------------------"
    echo "下载成功! 文件已保存到当前目录"
    
    # 获取实际的文件名（curl下载时会去掉@和组织前缀）
    # 例如: @jd-oh/basic-toast -> basic-toast
    if [[ "${PACKAGE_NAME}" == *"/"* ]]; then
        # 包含斜杠，提取斜杠后的部分
        ACTUAL_NAME="${PACKAGE_NAME##*/}"
    else
        # 不包含斜杠，去掉@符号
        ACTUAL_NAME="${PACKAGE_NAME#@}"
    fi
    
    HAR_FILE="${ACTUAL_NAME}-${VERSION}.har"
    echo "文件名: ${HAR_FILE}"
    
    # 检查文件是否存在
    if [ ! -f "${HAR_FILE}" ]; then
        echo "错误: 文件不存在: ${HAR_FILE}"
        exit 1
    fi
    
    # 解压文件
    echo "-----------------------------------"
    echo "正在解压文件..."
    tar -xzf "${HAR_FILE}"
    
    # 检查解压结果
    if [ $? -eq 0 ]; then
        echo "解压成功!"
        
        # 获取目标目录名（去掉.har后缀）
        TARGET_DIR="${HAR_FILE%.har}"
        
        # 检查解压后的 package 目录是否存在
        if [ -d "package" ]; then
            # 如果目标目录已存在，先删除
            if [ -d "${TARGET_DIR}" ]; then
                echo "目标目录已存在，先删除: ${TARGET_DIR}"
                rm -rf "${TARGET_DIR}"
            fi
            
            # 重命名 package 目录
            echo "重命名目录: package -> ${TARGET_DIR}"
            mv package "${TARGET_DIR}"
            
            if [ $? -ne 0 ]; then
                echo "⚠️  重命名失败!"
            fi
        fi
        
        # 删除原始压缩包
        echo "正在删除压缩包: ${HAR_FILE}"
        rm -f "${HAR_FILE}"
        
        if [ $? -eq 0 ]; then
            echo "-----------------------------------"
            echo "✅ 完成! 解压后的内容已保存到 ${TARGET_DIR} 目录"
        else
            echo "-----------------------------------"
            echo "⚠️  解压成功，但删除压缩包失败"
        fi
    else
        echo "-----------------------------------"
        echo "⚠️  解压失败! 压缩包已保留: ${HAR_FILE}"
        exit 1
    fi
else
    echo "-----------------------------------"
    echo "下载失败! 请检查网络连接和参数是否正确"
    exit 1
fi